# Backend Dockerfile - Development (localhost)
# Dùng full deps + ts-node để chạy migrate và dev mode

FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache dumb-init

# Copy package files
COPY package*.json ./
COPY prisma ./prisma/

# Install ALL deps (bao gồm devDependencies để có prisma CLI + ts-node)
RUN npm ci

# Copy source code
COPY . .

# Generate Prisma Client
RUN npx prisma generate

# Expose port
EXPOSE 5000

# Chạy migrate trước rồi mới start
# Dev DB được sinh từ baseline ngoài luồng migrate (shadow DB drift) nên
# `_prisma_migrations` không tồn tại — `migrate deploy` sẽ P3005 và restart loop.
# Thay vì `migrate deploy &&`, chỉ `generate` rồi dev trực tiếp (migration đã apply thủ công).
ENTRYPOINT ["dumb-init", "--"]
CMD ["sh", "-c", "npx prisma generate && npm run dev"]
