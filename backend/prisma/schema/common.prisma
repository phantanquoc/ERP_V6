enum InspectionRequestStatus {
  CHO_XU_LY // Chờ xử lý
  DA_TIEP_NHAN // Đã tiếp nhận
  DANG_KIEM_TRA // Đang kiểm tra
  DA_KIEM_TRA // Đã kiểm tra
  CHO_NGHIEM_THU // Chờ người yêu cầu xác nhận nghiệm thu (kết luận Đã khắc phục)
  HOAN_THANH // Hoàn thành
  DA_HUY // Đã hủy
  TU_CHOI // Từ chối

  @@schema("common")
}

model InspectionRequest {
  id             Int                     @id @default(autoincrement())
  ngayThang      DateTime                @default(now()) @map("ngay_thang")
  maYeuCau       String                  @unique @map("ma_yeu_cau")
  mucDoUuTien    String                  @map("muc_do_uu_tien")
  ghiChu         String?                 @map("ghi_chu") @db.Text
  trangThai      InspectionRequestStatus @default(CHO_XU_LY) @map("trang_thai")
  phongBanId     String?                 @map("phong_ban_id") @db.VarChar(30)
  fileDinhKem    String?                 @map("file_dinh_kem") // legacy single file — kept for old rows
  tepDinhKem     String[]                @default([]) @map("tep_dinh_kem")
  createdById    String?                 @map("created_by_id") // soft ref to auth.User.id
  createdByName  String?                 @map("created_by_name")
  ketQuaKiemTra  String?                 @map("ket_qua_kiem_tra") @db.Text
  mucDoHuHong    String?                 @map("muc_do_hu_hong")
  deXuatXuLy     String?                 @map("de_xuat_xu_ly") @db.Text
  thoiGianKiemTra DateTime?              @map("thoi_gian_kiem_tra") @db.Timestamptz
  nguoiKiemTra   String?                 @map("nguoi_kiem_tra")
  ketLuan        String?                 @map("ket_luan")
  anhKiemTra     String?                 @map("anh_kiem_tra")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  items               InspectionRequestItem[]
  statusLogs          InspectionRequestStatusLog[]
  repairRequests      RepairRequest[] // via RepairRequest.sourceInspectionRequestId
  acceptanceHandovers AcceptanceHandover[] // kết luận Đã khắc phục

  @@index([trangThai])
  @@index([phongBanId])
  @@index([createdById])
  @@map("inspection_requests")
  @@schema("common")
}

model InspectionRequestItem {
  id                    String            @id @default(cuid())
  inspectionRequestId   Int               @map("inspection_request_id")
  inspectionRequest     InspectionRequest @relation(fields: [inspectionRequestId], references: [id], onDelete: Cascade)
  machineSystemId       String?           @map("machine_system_id")
  machineSystemDetailId String?           @map("machine_system_detail_id")
  faultRecordId         String?           @map("fault_record_id") @db.VarChar(30)
  tenHeThong            String            @map("ten_he_thong")
  tinhTrangThietBi      String            @map("tinh_trang_thiet_bi")
  loaiLoi               String            @map("loai_loi")
  noiDungLoi            String            @map("noi_dung_loi") @db.Text
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  machineSystem       MachineSystem?       @relation(fields: [machineSystemId], references: [id], onDelete: SetNull)
  machineSystemDetail MachineSystemDetail? @relation(fields: [machineSystemDetailId], references: [id], onDelete: SetNull)
  faultRecord         FaultRecord?         @relation(fields: [faultRecordId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sourceRepairItems   RepairRequestItem[] // via RepairRequestItem.sourceInspectionItemId

  @@index([inspectionRequestId])
  @@index([machineSystemId])
  @@index([machineSystemDetailId])
  @@index([faultRecordId])
  @@map("inspection_request_items")
  @@schema("common")
}

model InspectionRequestStatusLog {
  id                  String                   @id @default(cuid())
  inspectionRequestId Int                      @map("inspection_request_id")
  inspectionRequest   InspectionRequest        @relation(fields: [inspectionRequestId], references: [id], onDelete: Cascade)
  oldStatus           InspectionRequestStatus?
  newStatus           InspectionRequestStatus
  actorId             String?                  @map("actor_id")
  actorRole           String?                  @map("actor_role")
  reason              String?                  @db.Text
  createdAt           DateTime                 @default(now()) @map("created_at")

  @@index([inspectionRequestId])
  @@index([createdAt])
  @@map("inspection_request_status_logs")
  @@schema("common")
}

