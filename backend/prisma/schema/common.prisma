//   SELECT id, ngay_thang, ma_yeu_cau, muc_do_uu_tien, ghi_chu, CASE trang_thai WHEN 'LEN_KE_HOACH' THEN 'HOAN_THANH'::common."InspectionRequestStatus" ELSE trang_thai::text::common."InspectionRequestStatus" END, phong_ban_id, file_dinh_kem, created_by_id, created_by_name, created_at, updated_at
