}

model FaceImage {
  id            String      @id @default(cuid())
  faceProfileId String
  imagePath     String // relative path under uploads/faces/
  embedding     String? // JSON array from AI service
  qualityScore  Float? // 0-1 combined score (blur+brightness+area+pose). null=legacy
  poseYaw       Float? // radians, |yaw| < 0.25 = frontal
  posePitch     Float? // radians, |pitch| < 0.28 = level
  capturedHour  Int? // 0-23, cho coverage guard (tránh gallery lệch giờ)
  rotatedAt     DateTime    @default(now()) // update mỗi lần replace, dùng cho TTL 6 tháng
  createdAt     DateTime    @default(now())
  faceProfile   FaceProfile @relation(fields: [faceProfileId], references: [id], onDelete: Cascade)

  @@index([faceProfileId])
  @@index([faceProfileId, rotatedAt])
  @@map("face_images")
  @@schema("common")
}

// Event log cho adaptive replacement — observability
