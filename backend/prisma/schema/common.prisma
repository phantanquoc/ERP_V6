  sourceInspectionItem   InspectionRequestItem?   @relation(fields: [sourceInspectionItemId], references: [id], onDelete: SetNull)
  phuongAnSua            String?                  @map("phuong_an_sua") @db.Text
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
