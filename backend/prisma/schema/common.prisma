// Shared acceptance slip for both YCSC (repairRequestId) and YCKT "Đã khắc phục" (inspectionRequestId).
// Exactly one of repairRequestId / inspectionRequestId is set. Confirmation is done by the requester
// (nguoiXacNhanId = auth.User.id), not by the technician who created the slip.
model AcceptanceHandover {
  id                    String           @id @default(cuid())
  maNghiemThu           String           @unique
  ngayNghiemThu         DateTime         @default(now())
  repairRequestId       Int? // ID của yêu cầu sửa chữa
  inspectionRequestId   Int?             @map("inspection_request_id") // ID của yêu cầu kiểm tra (kết luận Đã khắc phục)
  maYeuCauSuaChua       String // Mã phiếu nguồn (YC-SC-… hoặc YC-KT-…)
  tenHeThongThietBi     String // Tên hệ thống/thiết bị
  tinhTrangTruocSuaChua String           @db.Text // Tình trạng trước khi sửa chữa
  tinhTrangSauSuaChua   String           @db.Text // Tình trạng sau khi sửa chữa
  nguoiBanGiao          String // Người bàn giao (người sửa chữa)
  nguoiNhan             String // Người nhận (người yêu cầu)
  nguoiNhanId           String? // ID nhân viên người nhận (cho thông báo)
  fileDinhKem           String? // File đính kèm
  ghiChu                String?          @db.Text
  warehouseIssueId      String?          @map("warehouse_issue_id") @db.VarChar(30)
  chiPhiThucTe          Decimal?         @map("chi_phi_thuc_te") @db.Decimal(15, 2)
  ketQua                NghiemThuKetQua? @map("ket_qua")
  nguoiXacNhanId        String?          @map("nguoi_xac_nhan_id") // auth.User.id người phải xác nhận (người tạo yêu cầu)
  nguoiXacNhanTen       String?          @map("nguoi_xac_nhan_ten")
  xacNhanLuc            DateTime?        @map("xac_nhan_luc") @db.Timestamptz
  xacNhanBoiId          String?          @map("xac_nhan_boi_id") // auth.User.id người đã bấm xác nhận (ADMIN có thể thay)
  lyDoXacNhan           String?          @map("ly_do_xac_nhan") @db.Text
  createdById           String? // soft ref to auth.User.id — no FK constraint
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  repairRequest     RepairRequest?           @relation(fields: [repairRequestId], references: [id], onDelete: Cascade)
  inspectionRequest InspectionRequest?       @relation(fields: [inspectionRequestId], references: [id], onDelete: Cascade)
  items             AcceptanceHandoverItem[]

  @@index([createdById])
  @@index([inspectionRequestId])
  @@index([nguoiXacNhanId])
  @@index([warehouseIssueId])
  @@map("acceptance_handovers")
  @@schema("common")
}

model AcceptanceHandoverItem {
  id                    String   @id @default(cuid())
  acceptanceHandoverId  String
  repairRequestItemId   String
  machineSystemId       String?
  machineSystemDetailId String?
  tenHeThong            String
  tenChiTiet            String?
  tinhTrangTruocSuaChua String   @db.Text
  tinhTrangSauSuaChua   String   @db.Text
  ghiChu                String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  acceptanceHandover  AcceptanceHandover   @relation(fields: [acceptanceHandoverId], references: [id], onDelete: Cascade)
  repairRequestItem   RepairRequestItem    @relation(fields: [repairRequestItemId], references: [id], onDelete: Restrict)
  machineSystem       MachineSystem?       @relation(fields: [machineSystemId], references: [id], onDelete: SetNull)
  machineSystemDetail MachineSystemDetail? @relation(fields: [machineSystemDetailId], references: [id], onDelete: SetNull)

  @@unique([acceptanceHandoverId, repairRequestItemId])
  @@index([acceptanceHandoverId])
  @@index([repairRequestItemId])
  @@index([machineSystemId])
  @@index([machineSystemDetailId])
  @@map("acceptance_handover_items")
  @@schema("common")
}

