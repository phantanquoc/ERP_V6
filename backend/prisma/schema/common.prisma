model PayrollSettings {
  id                     String   @id @default(cuid())
  standardWorkDays       Int      @default(26)
  /// Giờ chuẩn một ngày công. Cùng với standardWorkDays tạo mẫu số để suy lương
  /// giờ từ lương tháng: hourlyRate = baseSalary / standardWorkDays / standardHoursPerDay.
  standardHoursPerDay    Float    @default(8)
  /// DEPRECATED — tiền OT phẳng (₫/giờ) dùng chung cho mọi nhân viên. Không thể
  /// đúng khi lương mỗi người một khác; giữ lại để không phá dữ liệu cũ. Tiền OT
  /// giờ suy từ lương từng người nhân hệ số otRate* bên dưới. Chỉ dùng làm fallback
  /// khi nhân viên chưa có baseSalary.
  overtimeRate           Float    @default(0)
  mealAllowancePerDay    Float    @default(0)
  overtimeMealAllowance  Float    @default(25000)
  sundayMealAllowance    Float    @default(0)
  fuelPricePerKm         Float    @default(0)
  otRateWeekday          Float    @default(1.5)
  otRateSunday           Float    @default(2)
  otRateHoliday          Float    @default(3)
  /// Selects which overtime figure payroll consumes. False (default) = planned
  /// hours, i.e. exactly the pre-change behaviour, so deploying moves no payslip.
  /// True = hours derived from the clock pair; a flagged participant-day pays zero.
  useActualOvertimeHours Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("payroll_settings")
  @@schema("common")
}

