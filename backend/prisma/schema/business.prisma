  CUM           @map("Cum")
  LINH_KIEN     @map("Linh kien")
  DIEM_KIEM_TRA @map("Diem kiem tra")

  @@schema("business")
}

model MachineSystemDetail {
  id              String                  @id @default(cuid())
  machineSystemId String
  parentDetailId  String?
  loaiChiTiet     MachineSystemDetailType
  maChiTiet       String                  @unique
  tenChiTiet      String
  viTri           String?
  moTa            String?                 @db.Text
  maNguoiPhuTrach String?
  nguoiPhuTrach   String?
  fileDinhKem     String?
  thuTu           Int                     @default(0)
  hoatDong        Boolean                 @default(true)
  trangThai       String                  @default("Hoạt động")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  machineSystem      MachineSystem            @relation(fields: [machineSystemId], references: [id], onDelete: Cascade)
  parentDetail       MachineSystemDetail?     @relation("MachineSystemDetailHierarchy", fields: [parentDetailId], references: [id], onDelete: SetNull)
  childDetails       MachineSystemDetail[]    @relation("MachineSystemDetailHierarchy")
  faultTemplates     FaultTemplate[]
  faultRecords       FaultRecord[]
  repairRequestItems RepairRequestItem[]
  handoverItems      AcceptanceHandoverItem[]

  @@index([machineSystemId])
  @@index([parentDetailId])
  @@index([loaiChiTiet])
  @@index([hoatDong])
  @@index([trangThai])
  @@index([machineSystemId, thuTu])
  @@map("machine_system_details")
  @@schema("business")
}

