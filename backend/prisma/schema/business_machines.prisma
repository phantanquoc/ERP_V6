// ─── Enums ───────────────────────────────────────────────────────────────────

enum MachineStatus {
  HOAT_DONG
  BAO_TRI
  NGUNG_HOAT_DONG

  @@schema("business")
}

enum MachineSystemCategory {
  SAN_XUAT
  DONG_GOI
  BAO_QUAN
  DIEN
  NUOC
  HOI
  KHI_NEN
  LAM_NONG
  VAN_CHUYEN
  PCCC
  CHAT_THAI
  KIEM_TRA_CL
  AN_TOAN
  KHAC

  @@schema("business")
}

enum MachineSystemDetailType {
  THIET_BI      @map("Thiet bi")
  CUM           @map("Cum")
  LINH_KIEN     @map("Linh kien")
  DIEM_KIEM_TRA @map("Diem kiem tra")

  @@schema("business")
}

enum MaintenanceFrequency {
  HANG_NGAY
  HANG_TUAN
  HANG_THANG
  HAI_THANG
  BA_THANG
  SAU_THANG
  HANG_NAM

  @@schema("business")
}

enum MaintenanceTeam {
  CO_KHI
  CO_DIEN
  DIEN
  TONG_HOP

  @@schema("business")
}

// ─── Models ──────────────────────────────────────────────────────────────────

model MachineSystem {
  id              String                @id @default(cuid())
  khuVuc          String
  viTri           String
  maHeThong       String                @unique
  tenHeThong      String
  chucNang        String                @db.Text
  loaiHeThong     MachineSystemCategory
  maThietBi       String?
  tenThietBi      String?
  nhiemVu         String?               @db.Text
  maNguoiThucHien String?
  nguoiThucHien   String?
  fileDinhKem     String?
  hoatDong        Boolean               @default(true)
  trangThai       MachineStatus         @default(HOAT_DONG)
  parentSystemId  String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  parentSystem       MachineSystem?           @relation("MachineSystemClones", fields: [parentSystemId], references: [id], onDelete: SetNull)
  clonedSystems      MachineSystem[]          @relation("MachineSystemClones")
  details            MachineSystemDetail[]
  faultTemplates     FaultTemplate[]
  faultRecords       FaultRecord[]
  repairRequestItems RepairRequestItem[]
  handoverItems      AcceptanceHandoverItem[]
  maintenancePlans   MaintenancePlan[]
  maintenanceRecords MaintenanceRecord[]
  statusLogs         MachineStatusLog[]
  systemOperations   SystemOperation[]
  finishedProducts   FinishedProduct[]
  qualityEvaluations QualityEvaluation[]

  @@index([maHeThong])
  @@index([parentSystemId])
  @@map("machine_systems")
  @@schema("business")
}

model MachineStatusLog {
  id             String        @id @default(cuid())
  machineSystemId String
  trangThaiCu    MachineStatus
  trangThaiMoi   MachineStatus
  nguyenNhan     String        @db.Text
  nguoiCapNhat   String
  ghiChu         String?       @db.Text
  thoiDiem       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  machineSystem MachineSystem @relation(fields: [machineSystemId], references: [id], onDelete: Cascade)

  @@index([machineSystemId])
  @@index([thoiDiem])
  @@map("machine_status_logs")
  @@schema("business")
}

model MachineSystemDetail {
  id              String                  @id @default(cuid())
  machineSystemId String
  parentDetailId  String?
  loaiChiTiet     MachineSystemDetailType
  maChiTiet       String                  @unique
  tenChiTiet      String
  viTri           String?
  moTa            String?                 @db.Text
  maNguoiPhuTrach String?
  nguoiPhuTrach   String?
  fileDinhKem     String?
  thuTu           Int                     @default(0)
  hoatDong        Boolean                 @default(true)
  trangThai       String                  @default("Hoạt động")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  machineSystem        MachineSystem            @relation(fields: [machineSystemId], references: [id], onDelete: Cascade)
  parentDetail         MachineSystemDetail?     @relation("MachineSystemDetailHierarchy", fields: [parentDetailId], references: [id], onDelete: SetNull)
  childDetails         MachineSystemDetail[]    @relation("MachineSystemDetailHierarchy")
  faultTemplates       FaultTemplate[]
  faultRecords         FaultRecord[]
  repairRequestItems   RepairRequestItem[]
  handoverItems        AcceptanceHandoverItem[]
  maintenanceTemplates MaintenanceTemplate[]
  maintenancePlanItems MaintenancePlanItem[]
  maintenanceRecords   MaintenanceRecord[]

  @@index([machineSystemId])
  @@index([parentDetailId])
  @@index([loaiChiTiet])
  @@index([hoatDong])
  @@index([trangThai])
  @@index([machineSystemId, thuTu])
  @@map("machine_system_details")
  @@schema("business")
}

model FaultTemplate {
  id                    String   @id @default(cuid())
  maMauLoi              String   @unique
  tenMauLoi             String
  moTa                  String   @db.Text
  mucDo                 String
  machineSystemId       String?
  machineSystemDetailId String?
  tenDetailGoiY         String?
  loaiDetailGoiY        String?
  hoatDong              Boolean  @default(true)
  trangThai             String   @default("Hoạt động")
  ghiChu                String?  @db.Text
  fileDinhKem           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  machineSystem       MachineSystem?       @relation(fields: [machineSystemId], references: [id], onDelete: SetNull)
  machineSystemDetail MachineSystemDetail? @relation(fields: [machineSystemDetailId], references: [id], onDelete: SetNull)
  faultRecords        FaultRecord[]

  @@index([machineSystemId])
  @@index([machineSystemDetailId])
  @@index([hoatDong])
  @@index([trangThai])
  @@map("fault_templates")
  @@schema("business")
}

model FaultRecord {
  id                    String   @id @default(cuid())
  maLoi                 String   @unique // VD: LI-2026-001
  tenLoi                String
  moTa                  String   @db.Text
  maHeThong             String? // soft ref tới MachineSystem.maHeThong
  machineSystemId       String?
  machineSystemDetailId String?
  faultTemplateId       String?
  mucDo                 String // Nghiêm trọng / Trung bình / Nhẹ
  trangThai             String   @default("Đang theo dõi") // Đang theo dõi / Đã xử lý / Tái phát
  nguoiPhatHien         String
  ngayPhatHien          DateTime @default(now())
  fileDinhKem           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  machineSystem       MachineSystem?       @relation(fields: [machineSystemId], references: [id], onDelete: SetNull)
  machineSystemDetail MachineSystemDetail? @relation(fields: [machineSystemDetailId], references: [id], onDelete: SetNull)
  faultTemplate       FaultTemplate?       @relation(fields: [faultTemplateId], references: [id], onDelete: SetNull)

  @@index([maLoi])
  @@index([machineSystemId])
  @@index([machineSystemDetailId])
  @@index([faultTemplateId])
  @@index([trangThai])
  @@map("fault_records")
  @@schema("business")
}

model SparePart {
  id          String    @id @default(cuid())
  maLinhKien  String    @unique // VD: LK-CK-2026-001
  tenLinhKien String
  loai        String // CK=Cơ khí, DT=Điện tử, D=Điện, TH=Tổng hợp
  donVi       String // Cái / Bộ / Mét / Kg
  soLuongTon  Int       @default(0)
  giaNhap     Float?
  nhaCungCap  String?
  trangThai   String    @default("Chưa sử dụng") // Đang sử dụng / Chưa sử dụng / Hết hàng
  ngayMua     DateTime?
  fileDinhKem String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([maLinhKien])
  @@index([loai])
  @@index([trangThai])
  @@map("spare_parts")
  @@schema("business")
}

model MaintenanceTemplate {
  id                    String               @id @default(cuid())
  machineSystemDetailId String?
  noiDung               String               @db.Text
  tanSuat               MaintenanceFrequency @default(BA_THANG)
  toThucHien            MaintenanceTeam      @default(CO_KHI)
  hoatDong              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  machineSystemDetail MachineSystemDetail?  @relation(fields: [machineSystemDetailId], references: [id], onDelete: SetNull)
  planItems           MaintenancePlanItem[]

  @@index([machineSystemDetailId])
  @@index([hoatDong])
  @@map("maintenance_templates")
  @@schema("business")
}

model MaintenancePlan {
  id              String   @id @default(cuid())
  maKeHoach       String   @unique
  machineSystemId String
  nam             Int
  nguoiLap        String
  ngayLap         DateTime @default(now())
  ghiChu          String?  @db.Text
  trangThai       String   @default("Đang thực hiện")
  fileDinhKem     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  machineSystem MachineSystem         @relation(fields: [machineSystemId], references: [id], onDelete: Cascade)
  items         MaintenancePlanItem[]
  records       MaintenanceRecord[]

  @@unique([machineSystemId, nam])
  @@index([machineSystemId])
  @@index([nam])
  @@map("maintenance_plans")
  @@schema("business")
}

model MaintenancePlanItem {
  id                    String               @id @default(cuid())
  maintenancePlanId     String
  machineSystemDetailId String
  maintenanceTemplateId String?
  noiDung               String               @db.Text
  tanSuat               MaintenanceFrequency @default(BA_THANG)
  toThucHien            MaintenanceTeam      @default(CO_KHI)
  soLuong               Int                  @default(1)
  thangBatDau           Int                  @default(1)  // Tháng bắt đầu chu kỳ (1-12)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  maintenancePlan     MaintenancePlan          @relation(fields: [maintenancePlanId], references: [id], onDelete: Cascade)
  machineSystemDetail MachineSystemDetail      @relation(fields: [machineSystemDetailId], references: [id], onDelete: Cascade)
  maintenanceTemplate MaintenanceTemplate?     @relation(fields: [maintenanceTemplateId], references: [id], onDelete: SetNull)
  logs                MaintenancePlanItemLog[]

  @@index([maintenancePlanId])
  @@index([machineSystemDetailId])
  @@map("maintenance_plan_items")
  @@schema("business")
}

model MaintenancePlanItemLog {
  id                      String    @id @default(cuid())
  maintenancePlanItemId   String
  thang                   Int       // 1-12
  lanThu                  Int       // which occurrence in that month, starting from 1
  hoanThanh               Boolean   @default(false)
  ghiChu                  String?   @db.Text
  ngayThucHien            DateTime?
  nguoiThucHien           String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  maintenancePlanItem MaintenancePlanItem @relation(fields: [maintenancePlanItemId], references: [id], onDelete: Cascade)

  @@unique([maintenancePlanItemId, thang, lanThu])
  @@index([maintenancePlanItemId])
  @@map("maintenance_plan_item_logs")
  @@schema("business")
}

model MaintenanceRecord {
  id                    String   @id @default(cuid())
  maBienBan             String   @unique
  maintenancePlanId     String?
  machineSystemId       String
  machineSystemDetailId String
  sourceLogId           String?  @unique
  loai                  String
  noiDung               String   @db.Text
  tinhTrangTruoc        String   @db.Text
  tinhTrangSau          String   @db.Text
  deXuat                String?  @db.Text
  thoiGianThucHien      String?
  ngayThucHien          DateTime
  nguoiThucHien         String
  fileDinhKem           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  maintenancePlan     MaintenancePlan?    @relation(fields: [maintenancePlanId], references: [id], onDelete: SetNull)
  machineSystem       MachineSystem       @relation(fields: [machineSystemId], references: [id], onDelete: Cascade)
  machineSystemDetail MachineSystemDetail @relation(fields: [machineSystemDetailId], references: [id], onDelete: Cascade)

  @@index([maintenancePlanId])
  @@index([machineSystemId])
  @@index([machineSystemDetailId])
  @@index([ngayThucHien])
  @@index([sourceLogId])
  @@map("maintenance_records")
  @@schema("business")
}

model Project {
  id          String    @id @default(cuid())
  maDuAn      String    @unique // VD: DA-2026-001
  tenDuAn     String
  moTa        String?   @db.Text
  ngayBatDau  DateTime
  ngayKetThuc DateTime?
  trangThai   String    @default("Lên kế hoạch") // Lên kế hoạch / Chờ duyệt / Đang thực hiện / Hoàn thành / Tạm dừng
  nguoiTaoId  String // userId người tạo
  fileDinhKem String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members   ProjectMember[]
  phases    ProjectPhase[]
  tasks     ProjectTask[]
  updates   ProjectUpdate[]
  costs     ProjectCost[]
  approvals ProjectApproval[]

  @@index([nguoiTaoId])
  @@index([trangThai])
  @@map("projects")
  @@schema("business")
}

model ProjectPhase {
  id              String    @id @default(cuid())
  projectId       String
  tenGiaiDoan     String
  moTa            String?   @db.Text
  chuSoHuuId      String?
  chuSoHuu        String?
  nguoiPhuTrachId String?
  nguoiPhuTrach   String?
  tienDo          Int       @default(0)
  nganSach        Float?
  trangThai       String    @default("Chưa bắt đầu")
  thuTu           Int       @default(0)
  ngayBatDau      DateTime?
  ngayKetThuc     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks      ProjectTask[]
  taskGroups ProjectTaskGroup[]
  updates    ProjectUpdate[]
  costs      ProjectCost[]

  @@index([projectId])
  @@index([trangThai])
  @@index([projectId, thuTu])
  @@map("project_phases")
  @@schema("business")
}

model ProjectTaskGroup {
  id             String   @id @default(cuid())
  projectPhaseId String
  tenMuc         String
  moTa           String?  @db.Text
  thuTu          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projectPhase ProjectPhase  @relation(fields: [projectPhaseId], references: [id], onDelete: Cascade)
  tasks        ProjectTask[]

  @@index([projectPhaseId])
  @@index([projectPhaseId, thuTu])
  @@map("project_task_groups")
  @@schema("business")
}

model ProjectMember {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  vaiTro      String   @default("Thành viên") // Quản lý / Thành viên / Cố vấn
  ngayThamGia DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
  @@schema("business")
}

model ProjectTask {
  id                  String        @id @default(cuid())
  projectId           String
  projectPhaseId      String?
  projectTaskGroupId  String?
  tieuDe              String
  moTa                String?       @db.Text
  nguoiPhuTrach       String?
  tienDo              Int           @default(0)
  ngayBatDau          DateTime?
  ngayKetThuc         DateTime?
  ngayBatDauThucTe    DateTime?
  ngayHoanThanhThucTe DateTime?
  deadline            DateTime?
  trangThai           String        @default("Chưa bắt đầu") // Chưa bắt đầu / Đang làm / Hoàn thành / Trễ
  mucDoUuTien         TaskPriority?
  laMilestone         Boolean       @default(false)
  laPhatSinh          Boolean       @default(false)
  ghiChu              String?       @db.Text
  thuTu               Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectPhase     ProjectPhase?     @relation(fields: [projectPhaseId], references: [id], onDelete: Cascade)
  projectTaskGroup ProjectTaskGroup? @relation(fields: [projectTaskGroupId], references: [id], onDelete: SetNull)
  costs            ProjectCost[]

  @@index([projectId])
  @@index([projectPhaseId])
  @@index([projectTaskGroupId])
  @@index([projectId, projectPhaseId, thuTu])
  @@map("project_tasks")
  @@schema("business")
}

model ProjectUpdate {
  id             String   @id @default(cuid())
  projectId      String
  projectPhaseId String?
  ngay           DateTime
  tieuDe         String
  noiDung        String   @db.Text
  tienDoHienTai  Int      @default(0)
  fileDinhKem    String?
  nguoiCapNhat   String
  nguoiCapNhatId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectPhase ProjectPhase? @relation(fields: [projectPhaseId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([projectPhaseId])
  @@index([projectId, ngay])
  @@map("project_updates")
  @@schema("business")
}

model ProjectCost {
  id               String   @id @default(cuid())
  projectId        String
  projectPhaseId   String?
  projectTaskId    String?
  loaiChiPhi       String // Nhân công / Vật tư / Phụ liệu / Khác
  tenChiPhi        String?
  donVi            String?
  soLuongKeHoach   Float?
  giaKeHoach       Float?
  thanhTienKeHoach Float?
  soLuongThucTe    Float?
  giaThucTe        Float?
  thanhTienThucTe  Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectPhase ProjectPhase? @relation(fields: [projectPhaseId], references: [id], onDelete: SetNull)
  projectTask  ProjectTask?  @relation(fields: [projectTaskId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectPhaseId])
  @@index([projectTaskId])
  @@map("project_costs")
  @@schema("business")
}

model ProjectApproval {
  id           String   @id @default(cuid())
  projectId    String
  nguoiGuiId   String
  nguoiDuyetId String?
  trangThai    String   @default("CHO_DUYET") // CHO_DUYET | DA_DUYET | TU_CHOI
  lyDoTuChoi   String?  @db.Text
  ghiChu       String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_approvals")
  @@schema("business")
}
