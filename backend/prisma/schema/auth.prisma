model User {
  id                              String                           @id @default(cuid())
  email                           String                           @unique
  password                        String
  firstName                       String
  lastName                        String
  role                            UserRole                         @default(EMPLOYEE)
  isActive                        Boolean                          @default(true)
  departmentId                    String?
  subDepartmentId                 String?
  supervisor1Id                   String?
  supervisor2Id                   String?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  loginHistory                    LoginHistory[]
  refreshTokens                   RefreshToken[]
  userRoles                       UserRoleAssignment[]
  employees                       Employee?
  privateFeedbacks                PrivateFeedback[]
  pushSubscriptions               PushSubscription[]
  notificationPreferences         NotificationPreference[]
  secondaryDepartments            UserSecondaryDepartment[]
  delegationsFrom                 Delegation[]                     @relation("DelegationFrom")
  delegationsTo                   Delegation[]                     @relation("DelegationTo")
  processFlowchartSectionFiles    ProcessFlowchartSectionFile[]    @relation("ProcessFlowchartSectionFileUploader")
  productionFlowchartSectionFiles ProductionFlowchartSectionFile[] @relation("ProductionFlowchartSectionFileUploader")

  @@index([departmentId])
  @@index([subDepartmentId])
  @@map("users")
  @@schema("auth")
}

model UserSecondaryDepartment {
  id              String   @id @default(cuid())
  userId          String
  departmentId    String
  subDepartmentId String?
  role            UserRole @default(EMPLOYEE)
  positionId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId, subDepartmentId])
  @@index([positionId])
  @@map("user_secondary_departments")
  @@schema("auth")
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String?
  userAgent String?
  device    String?
  browser   String?
  location  String?
  status    String
  loginAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("login_history")
  @@schema("auth")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@schema("auth")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
  @@schema("auth")
}

model Role {
  id          String               @id @default(cuid())
  name        String               @unique
  description String?
  level       Int
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  permissions RolePermission[]
  userRoles   UserRoleAssignment[]

  @@map("roles")
  @@schema("auth")
}

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  action          PermissionAction
  resource        ResourceType
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
  @@schema("auth")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
  @@schema("auth")
}

model UserRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
  @@schema("auth")
}

enum UserRole {
  ADMIN
  DEPARTMENT_HEAD
  TEAM_LEAD
  EMPLOYEE

  @@schema("auth")
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  REJECT
  EXPORT
  IMPORT

  @@schema("auth")
}

enum RuleScope {
  GLOBAL
  DEPARTMENT
  SUB_DEPARTMENT

  @@schema("auth")
}

model Resource {
  code      String @id
  label     String
  /// Allowed groups: system, hr, quality, production, finance, business, purchasing, warehouse, technical, project
  group     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rules       Rule[]
  delegations Delegation[]

  @@map("resources")
  @@schema("auth")
}

/// Rule scope ↔ ids invariant (validated app-side in ruleService.validateScopeFields):
///   GLOBAL → departmentId IS NULL && subDepartmentId IS NULL
///   DEPARTMENT → departmentId NOT NULL && subDepartmentId IS NULL
///   SUB_DEPARTMENT → subDepartmentId NOT NULL (departmentId optional, derived via SubDepartment)
/// Pg NULL != NULL so @@unique does NOT block duplicate GLOBAL rows — dedup is app-level via findFirst IS NULL.
/// Cross-schema FKs (departmentId/subDepartmentId/positionId → common.*) are kept as loose strings
/// intentionally: Prisma cross-schema FK requires same datasource + migration complexity, and
/// orphan risk is covered by seed-time checks (see Group 3.4).
model Rule {
  id               String           @id @default(cuid())
  resourceCode     String
  action           PermissionAction
  scope            RuleScope        @default(GLOBAL)
  departmentId     String?
  subDepartmentId  String?
  positionId       String?
  role             UserRole?
  allow            Boolean          @default(true)
  isActive         Boolean          @default(true)
  responsibilityId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  resource         Resource         @relation(fields: [resourceCode], references: [code], onDelete: Cascade)
  auditLogs        RuleAuditLog[]

  @@unique([resourceCode, action, scope, departmentId, subDepartmentId, positionId, role])
  @@index([resourceCode, action])
  @@index([scope, departmentId, subDepartmentId])
  @@index([positionId])
  @@index([role])
  @@index([isActive])
  @@index([isActive, resourceCode, action])
  @@index([responsibilityId])
  @@map("rules")
  @@schema("auth")
}

model RuleAuditLog {
  id        String   @id @default(cuid())
  ruleId    String?
  actorId   String?
  /// Values: CREATE | UPDATE | DELETE (kept as String to avoid enum migration; validated app-side)
  action    String
  before    Json?    @db.JsonB
  after     Json?    @db.JsonB
  createdAt DateTime @default(now())
  rule      Rule?    @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([ruleId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([actorId])
  @@map("rule_audit_logs")
  @@schema("auth")
}

model Delegation {
  id              String           @id @default(cuid())
  fromUserId      String
  toUserId        String
  resourceCode    String
  action          PermissionAction
  departmentId    String?
  subDepartmentId String?
  from            DateTime
  to              DateTime
  isActive        Boolean          @default(true)
  createdBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  resource        Resource         @relation(fields: [resourceCode], references: [code], onDelete: Cascade)
  fromUser        User             @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser          User             @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, isActive])
  @@index([resourceCode, action])
  @@map("delegations")
  @@schema("auth")
}
