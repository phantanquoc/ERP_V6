// ─── Enums ───────────────────────────────────────────────────────────────────

enum SystemOperationStatus {
  DANG_HOAT_DONG
  BAO_TRI
  NGUNG_HOAT_DONG

  @@schema("business")
}

// ─── Models ──────────────────────────────────────────────────────────────────

model SupplyRequest {
  id                String              @id @default(cuid())
  stt               Int                 @default(autoincrement())
  ngayYeuCau        DateTime            @default(now())
  maYeuCau          String              @unique
  employeeId        String
  maNhanVien        String
  tenNhanVien       String
  boPhan            String
  // @deprecated — kept for backward compatibility, use items relation instead
  phanLoai          String?
  // @deprecated — kept for backward compatibility, use items relation instead
  tenGoi            String?
  // @deprecated — kept for backward compatibility, use items relation instead
  soLuong           Float?
  // @deprecated — kept for backward compatibility, use items relation instead
  donViTinh         String?
  mucDichYeuCau     String
  mucDoUuTien       String
  ghiChu            String?
  trangThai         String              @default("Chưa cung cấp")
  fileKemTheo       String?
  loaiYeuCau        String?             @default("Thường") // "Thường" | "Mua nhanh"
  soTien            Float? // Số tiền thực tế (dùng cho Mua nhanh)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  employee          Employee            @relation(fields: [employeeId], references: [id])
  items             SupplyRequestItem[]
  purchaseRequests  PurchaseRequest[]
  warehouseReceipts WarehouseReceipt[]
  warehouseIssues   WarehouseIssue[]

  @@map("supply_requests")
  @@schema("business")
}

model SupplyRequestItem {
  id                String                  @id @default(cuid())
  supplyRequestId   String
  phanLoai          String
  tenGoi            String
  soLuong           Float
  donViTinh         String
  // Flag: hàng hóa này chưa có trong InternationalProduct (người yêu cầu nhập tên tự do)
  isNewProduct      Boolean                 @default(false)
  // Fulfillment tracking — how much has actually been delivered to requester (from warehouse issues)
  fulfilledQty      Float                   @default(0)
  // Per-item status: "Chờ xử lý" | "Đủ tồn kho" | "Thiếu tồn kho" | "Đã cấp một phần" | "Đã cấp đủ" | "Đã hủy"
  fulfillmentStatus String                  @default("Chờ xử lý")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  supplyRequest     SupplyRequest           @relation(fields: [supplyRequestId], references: [id], onDelete: Cascade)
  decisions         SupplyRequestDecision[]

  @@map("supply_request_items")
  @@schema("business")
}

// Audit trail — every warehouse decision on an internal supply request item
model SupplyRequestDecision {
  id                         String            @id @default(cuid())
  supplyRequestItemId        String
  // "Cấp đủ" | "Cấp một phần" | "Không cấp" | "Chuyển thu mua"
  decision                   String
  fulfilledQty               Float             @default(0)
  shortageQty                Float             @default(0)
  reason                     String?
  // Employee (warehouse staff) who made the decision
  decidedByEmployeeId        String
  decidedAt                  DateTime          @default(now())
  // Optional link to auto-created purchase request when decision routes shortage to procurement
  triggeredPurchaseRequestId String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  supplyRequestItem          SupplyRequestItem @relation(fields: [supplyRequestItemId], references: [id], onDelete: Cascade)

  @@index([supplyRequestItemId])
  @@index([decidedByEmployeeId])
  @@map("supply_request_decisions")
  @@schema("business")
}

model PurchaseRequest {
  id              String                @id @default(cuid())
  stt             Int                   @default(autoincrement())
  ngayYeuCau      DateTime              @default(now())
  maYeuCau        String                @unique
  employeeId      String
  maNhanVien      String
  tenNhanVien     String
  // @deprecated — kept for backward compatibility, use items relation instead
  phanLoai        String?
  // @deprecated — kept for backward compatibility, use items relation instead
  tenHangHoa      String?
  // @deprecated — kept for backward compatibility, use items relation instead
  soLuong         Float?
  // @deprecated — kept for backward compatibility, use items relation instead
  donViTinh       String?
  mucDichYeuCau   String
  mucDoUuTien     String
  ghiChu          String?
  fileKemTheo     String?
  trangThai       String                @default("Chờ duyệt")
  nguoiDuyet      String?
  ngayDuyet       DateTime?
  supplyRequestId String?
  nhaCungCapId    String?
  giaDuKien       Float?
  ghiChuMuaHang   String?
  // Quick purchase = auto-generated or urgent procurement, skips normal approval workflow
  isQuickPurchase Boolean               @default(false)
  // Source of this PR: "MANUAL" | "SHORTAGE" (from SR partial fulfill) | "REORDER" (from low-stock alert) | "QUICK" (Mua nhanh SR)
  sourceType      String                @default("MANUAL")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  employee        Employee              @relation(fields: [employeeId], references: [id])
  supplyRequest   SupplyRequest?        @relation(fields: [supplyRequestId], references: [id])
  supplier        Supplier?             @relation(fields: [nhaCungCapId], references: [id])
  items           PurchaseRequestItem[]

  @@map("purchase_requests")
  @@schema("business")
}

model PurchaseRequestItem {
  id                String          @id @default(cuid())
  purchaseRequestId String
  phanLoai          String
  tenHangHoa        String
  soLuong           Float
  donViTinh         String
  nhaCungCapId      String?
  giaDuKien         Float?
  supplier          Supplier?       @relation("PurchaseRequestItemSupplier", fields: [nhaCungCapId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@map("purchase_request_items")
  @@schema("business")
}

model Supplier {
  id                   String                @id @default(cuid())
  maNhaCungCap         String                @unique
  tenNhaCungCap        String
  loaiCungCap          String // Loại cung cấp (VD: Thủy sản, Rau củ, Gia vị...)
  quocGia              String
  website              String?
  nguoiLienHe          String
  soDienThoai          String
  emailLienHe          String
  diaChi               String
  khaNang              String? // Khả năng cung cấp
  loaiHinh             String // Sản xuất, Thương mại
  trangThai            String                @default("Đang cung cấp") // Đang cung cấp, Ngừng cung cấp
  phanLoaiNCC          String                @default("NVL") // NVL, Thiết bị
  doanhChi             Float? // Doanh chi
  employeeId           String
  employee             Employee              @relation("SupplierCreatedBy", fields: [employeeId], references: [id])
  purchaseRequests     PurchaseRequest[]
  purchaseRequestItems PurchaseRequestItem[] @relation("PurchaseRequestItemSupplier")
  debts                Debt[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@map("suppliers")
  @@schema("business")
}

model warehouses {
  id          String   @id
  maKho       String   @unique
  tenKho      String
  loaiKho     String?
  diaChi      String?
  dienTich    Float?
  sucChua     Float?
  nguoiQuanLy String?
  soDienThoai String?
  trangThai   String   @default("active")
  ghiChu      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  lots        Lot[]
  warehouseSlots WarehouseSlot[]

  @@schema("business")
}

model WarehouseSlot {
  id          String       @id // deterministic 'WS-<maKho>-<zone>-<code>' for stable migration seeding
  warehouseId String
  zone        String
  code        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  warehouse   warehouses   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  lotProducts LotProduct[]

  @@unique([warehouseId, zone, code])
  @@map("warehouse_slots")
  @@schema("business")
}

model Lot {
  id          String       @id @default(cuid())
  tenLo       String
  warehouseId String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lotProducts LotProduct[]
  warehouse   warehouses   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@map("lots")
  @@schema("business")
}

model LotProduct {
  id                     String                 @id @default(cuid())
  lotId                  String
  internationalProductId String
  soLuong                Float
  donViTinh              String
  maKien                 String?
  slotId                 String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  giaThanh               Float?                 @default(100000)
  internationalProduct   InternationalProduct   @relation(fields: [internationalProductId], references: [id], onDelete: Cascade)
  lot                    Lot                    @relation(fields: [lotId], references: [id], onDelete: Cascade)
  slot                   WarehouseSlot?         @relation(fields: [slotId], references: [id], onDelete: SetNull)
  materialEvaluations    MaterialEvaluation[]
  warehouseReceipts      WarehouseReceiptItem[]
  warehouseIssues        WarehouseIssueItem[]

  @@unique([lotId, maKien])
  @@map("lot_products")
  @@schema("business")
}

model WarehouseReceipt {
  id                String                 @id @default(cuid())
  maPhieuNhap       String                 @unique
  ngayNhap          DateTime               @default(now())
  employeeId        String
  maNhanVien        String
  tenNhanVien       String
  // @deprecated — item-level column, kept for backward compatibility; use items relation instead
  warehouseId       String?
  // @deprecated — item-level column, kept for backward compatibility; use items relation instead
  tenKho            String?
  // @deprecated — item-level column, kept for backward compatibility; use items relation instead
  lotId             String?
  // @deprecated — item-level column, kept for backward compatibility; use items relation instead
  tenLo             String?
  // @deprecated — item-level column, kept for backward compatibility; use items relation instead
  lotProductId      String?
  // @deprecated — item-level column, kept for backward compatibility; use items relation instead
  tenSanPham        String?
  // @deprecated — item-level column, kept for backward compatibility; use items relation instead
  soLuongTruoc      Float?                 @default(0) // Số lượng tồn kho trước khi nhập
  // @deprecated — item-level column, kept for backward compatibility; use items relation instead
  soLuongNhap       Float?
  // @deprecated — item-level column, kept for backward compatibility; use items relation instead
  soLuongSau        Float?                 @default(0) // Số lượng tồn kho sau khi nhập
  // @deprecated — item-level column, kept for backward compatibility; use items relation instead
  donViTinh         String?
  mucDich           String? // Mục đích nhập kho (VD: "Nhập từ thu mua", "Nhập thành phẩm")
  ghiChu            String?
  supplyRequestId   String?
  supplyRequest     SupplyRequest?         @relation(fields: [supplyRequestId], references: [id])
  // Derived totals across items — recomputed inside the same transaction as any item mutation
  tongSoLuongThucTe Float                  @default(0)
  soDongHang        Int                    @default(0)
  items             WarehouseReceiptItem[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@map("warehouse_receipts")
  @@schema("business")
}

model WarehouseReceiptItem {
  id            String           @id @default(cuid())
  receiptId     String
  stt           Int
  lotProductId  String
  tenSanPham    String
  donViTinh     String
  warehouseId   String
  tenKho        String
  lotId         String
  tenLo         String
  soLuongYeuCau Float
  soLuongThucTe Float
  soLuongTruoc  Float
  soLuongSau    Float
  donGia        Float?
  thanhTien     Float?
  ghiChu        String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  receipt       WarehouseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  lotProduct    LotProduct       @relation(fields: [lotProductId], references: [id], onDelete: Restrict)

  @@index([receiptId])
  @@index([lotProductId])
  @@map("warehouse_receipt_items")
  @@schema("business")
}

model WarehouseIssue {
  id                 String               @id @default(cuid())
  maPhieuXuat        String               @unique
  ngayXuat           DateTime             @default(now())
  employeeId         String
  maNhanVien         String
  tenNhanVien        String
  // @deprecated — item-level column, kept for backward compatibility; use items relation instead
  warehouseId        String?
  // @deprecated — item-level column, kept for backward compatibility; use items relation instead
  tenKho             String?
  // @deprecated — item-level column, kept for backward compatibility; use items relation instead
  lotId              String?
  // @deprecated — item-level column, kept for backward compatibility; use items relation instead
  tenLo              String?
  // @deprecated — item-level column, kept for backward compatibility; use items relation instead
  lotProductId       String?
  // @deprecated — item-level column, kept for backward compatibility; use items relation instead
  tenSanPham         String?
  // @deprecated — item-level column, kept for backward compatibility; use items relation instead
  soLuongTruoc       Float?               @default(0) // Số lượng tồn kho trước khi xuất
  // @deprecated — item-level column, kept for backward compatibility; use items relation instead
  soLuongXuat        Float?
  // @deprecated — item-level column, kept for backward compatibility; use items relation instead
  soLuongSau         Float?               @default(0) // Số lượng tồn kho sau khi xuất
  // @deprecated — item-level column, kept for backward compatibility; use items relation instead
  donViTinh          String?
  ghiChu             String?
  supplyRequestId    String?
  supplyRequest      SupplyRequest?       @relation(fields: [supplyRequestId], references: [id])
  materialEvaluation MaterialEvaluation?
  // Derived totals across items — recomputed inside the same transaction as any item mutation
  tongSoLuongThucTe  Float                @default(0)
  soDongHang         Int                  @default(0)
  items              WarehouseIssueItem[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@map("warehouse_issues")
  @@schema("business")
}

model WarehouseIssueItem {
  id            String         @id @default(cuid())
  issueId       String
  stt           Int
  lotProductId  String
  tenSanPham    String
  donViTinh     String
  warehouseId   String
  tenKho        String
  lotId         String
  tenLo         String
  soLuongYeuCau Float
  soLuongThucTe Float
  soLuongTruoc  Float
  soLuongSau    Float
  donGia        Float?
  thanhTien     Float?
  ghiChu        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  issue         WarehouseIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  lotProduct    LotProduct     @relation(fields: [lotProductId], references: [id], onDelete: Restrict)

  @@index([issueId])
  @@index([lotProductId])
  @@map("warehouse_issue_items")
  @@schema("business")
}

model MaterialEvaluation {
  id                   String    @id @default(cuid())
  maChien              String
  thoiGianChien        DateTime
  ngaySanXuat          DateTime? @db.Date // Production day (06:30 boundary); nullable for pre-backfill rows
  ca                   Int? // Production shift (1, 2, or 3); nullable for legacy rows
  tenHangHoa           String
  maSanPham            String? // Commodity code — the identifier shown on kiosk screens; null when there is no warehouse link to derive it from
  soLoKien             String
  khoiLuong            Float
  soLanNgam            Int
  nhietDoNuocTruocNgam Float
  nhietDoNuocSauVot    Float
  thoiGianNgam         Int
  brixNuocNgam         Float
  danhGiaTruocNgam     String
  danhGiaSauNgam       String
  ghiChu               String?
  fileDinhKem          String?
  nguoiThucHien        String

  // Warehouse integration (nullable, SetNull on warehouse delete)
  lotProductId     String?
  lotProduct       LotProduct?     @relation(fields: [lotProductId], references: [id], onDelete: SetNull)
  warehouseIssueId String?         @unique
  warehouseIssue   WarehouseIssue? @relation(fields: [warehouseIssueId], references: [id], onDelete: SetNull)

  createdById String? // soft ref to auth.User.id — no FK constraint
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  systemOperations   SystemOperation[]
  finishedProducts   FinishedProduct[]
  qualityEvaluations QualityEvaluation[]

  @@unique([maChien, ngaySanXuat])
  @@index([lotProductId])
  @@index([createdById])
  @@index([maSanPham])
  @@map("material_evaluations")
  @@schema("business")
}

model MaterialEvaluationCriteria {
  id          String   @id @default(cuid())
  code        Int      @unique
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("material_evaluation_criteria")
  @@schema("business")
}

model SystemOperation {
  id              String    @id @default(cuid())
  maChien         String
  machineSystemId String?
  thoiGianChien   DateTime
  ngaySanXuat     DateTime? @db.Date // Production day (06:30 boundary)
  khoiLuongDauVao Float?    @default(0)

  // Giai đoạn 1
  giaiDoan1ThoiGian Int   @default(0)
  giaiDoan1NhietDo  Float @default(0)
  giaiDoan1ApSuat   Float @default(0)

  // Giai đoạn 2
  giaiDoan2ThoiGian Int   @default(0)
  giaiDoan2NhietDo  Float @default(0)
  giaiDoan2ApSuat   Float @default(0)

  // Giai đoạn 3
  giaiDoan3ThoiGian Int   @default(0)
  giaiDoan3NhietDo  Float @default(0)
  giaiDoan3ApSuat   Float @default(0)

  // Giai đoạn 4
  giaiDoan4ThoiGian Int   @default(0)
  giaiDoan4NhietDo  Float @default(0)
  giaiDoan4ApSuat   Float @default(0)

  tongThoiGianSay Int                   @default(0)
  trangThai       SystemOperationStatus @default(DANG_HOAT_DONG)
  ghiChu          String?
  nguoiThucHien   String

  materialEvaluationId String?
  materialEvaluation   MaterialEvaluation? @relation(fields: [materialEvaluationId], references: [id], onDelete: SetNull)

  machineSystem MachineSystem? @relation(fields: [machineSystemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([maChien, ngaySanXuat, machineSystemId])
  @@index([machineSystemId])
  @@map("system_operations")
  @@schema("business")
}

model FinishedProduct {
  id            String    @id @default(cuid())
  maChien       String
  thoiGianChien DateTime
  ngaySanXuat   DateTime? @db.Date // Production day (06:30 boundary)
  tenHangHoa    String
  maSanPham     String? // Commodity code — the identifier shown on kiosk screens; null when there is no product link to derive it from
  khoiLuong     Float

  // Relation to MachineSystem
  machineSystemId String?
  trangThai       SystemOperationStatus @default(DANG_HOAT_DONG)
  machineSystem   MachineSystem?        @relation(fields: [machineSystemId], references: [id], onDelete: SetNull)

  // Relation to MaterialEvaluation
  materialEvaluationId String?
  materialEvaluation   MaterialEvaluation? @relation(fields: [materialEvaluationId], references: [id], onDelete: SetNull)

  // Relation to InternationalProduct (base product link for warehouse receipt)
  internationalProductId String?
  internationalProduct   InternationalProduct? @relation(fields: [internationalProductId], references: [id], onDelete: SetNull)

  // Thành phẩm A
  aKhoiLuong Float @default(0)
  aTiLe      Float @default(0)

  // Thành phẩm B
  bKhoiLuong Float @default(0)
  bTiLe      Float @default(0)

  // Thành phẩm B Dầu
  bDauKhoiLuong Float @default(0)
  bDauTiLe      Float @default(0)

  // Thành phẩm C
  cKhoiLuong Float @default(0)
  cTiLe      Float @default(0)

  // Vụn lớn
  vunLonKhoiLuong Float @default(0)
  vunLonTiLe      Float @default(0)

  // Vụn nhỏ
  vunNhoKhoiLuong Float @default(0)
  vunNhoTiLe      Float @default(0)

  // Phế phẩm
  phePhamKhoiLuong Float @default(0)
  phePhamTiLe      Float @default(0)

  // Ướt
  uotKhoiLuong Float @default(0)
  uotTiLe      Float @default(0)

  // Tổng khối lượng thành phẩm đầu ra
  tongKhoiLuong Float @default(0)

  // Flag: đã nhập kho hay chưa (set true atomically trong warehouse receipt transaction)
  daNhapKho Boolean @default(false)

  ghiChu        String?
  fileDinhKem   String?
  nguoiThucHien String

  createdById        String? // soft ref to auth.User.id — no FK constraint
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  qualityEvaluations QualityEvaluation[]
  entryHistory       FinishedProductEntryHistory[]

  @@unique([maChien, ngaySanXuat, machineSystemId])
  @@index([machineSystemId])
  @@index([internationalProductId])
  @@index([createdById])
  @@index([maSanPham])
  @@map("finished_products")
  @@schema("business")
}

model FinishedProductEntryHistory {
  id                String    @id @default(cuid())
  finishedProductId String
  maChien           String
  ngaySanXuat       DateTime? @db.Date
  machineSystemId   String?
  grade             String // e.g. "aKhoiLuong", "bKhoiLuong", etc.
  khoiLuong         Float // the weight value entered for this grade
  employeeId        String? // soft ref to common.Employee.id — no FK constraint
  employeeName      String? // denormalized name for display
  enteredAt         DateTime  @default(now())

  finishedProduct FinishedProduct @relation(fields: [finishedProductId], references: [id], onDelete: Cascade)

  @@index([finishedProductId])
  @@index([maChien, ngaySanXuat, machineSystemId])
  @@index([employeeId])
  @@map("finished_product_entry_history")
  @@schema("business")
}

model QualityEvaluation {
  id            String    @id @default(uuid())
  maChien       String
  thoiGianChien String
  ngaySanXuat   DateTime? @db.Date // Production day (06:30 boundary)
  tenHangHoa    String
  mauSac        String    @default("")

  // Relation to MachineSystem
  machineSystemId String?
  machineSystem   MachineSystem? @relation(fields: [machineSystemId], references: [id], onDelete: SetNull)

  // Relation to FinishedProduct
  finishedProductId String?
  finishedProduct   FinishedProduct? @relation(fields: [finishedProductId], references: [id], onDelete: SetNull)

  // Relation to MaterialEvaluation
  materialEvaluationId String?
  materialEvaluation   MaterialEvaluation? @relation(fields: [materialEvaluationId], references: [id], onDelete: SetNull)

  // Tỉ lệ thành phẩm đầu ra (%) - Auto-filled from finished_product
  aTiLe       Float @default(0)
  bTiLe       Float @default(0)
  bDauTiLe    Float @default(0)
  cTiLe       Float @default(0)
  vunLonTiLe  Float @default(0)
  vunNhoTiLe  Float @default(0)
  phePhamTiLe Float @default(0)
  uotTiLe     Float @default(0)

  // Đánh giá chất lượng thành phẩm đầu ra
  muiHuong String @default("")
  huongVi  String @default("")
  doNgot   String @default("")
  doGion   String @default("")

  // Đánh giá tổng quan
  danhGiaTongQuan String @default("")

  // Đề xuất điều chỉnh cải tiến
  deXuatDieuChinh String @default("")

  fileDinhKem   String?
  nguoiThucHien String

  createdById String? // soft ref to auth.User.id — no FK constraint
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([maChien, ngaySanXuat, machineSystemId])
  @@index([machineSystemId])
  @@index([createdById])
  @@map("quality_evaluations")
  @@schema("business")
}

model ProductionReport {
  id                            String  @id @default(uuid())
  ngayThang                     String // Ngày tháng
  tongSoTuaSanXuat              Int     @default(0) // Tổng số tua sản xuất/ngày
  soMeTua                       Int     @default(0) // Số mẻ/tua
  tongSoMeKeHoach               Int     @default(0) // Tổng số mẻ sản xuất kế hoạch
  soMeThucTe                    Int     @default(0) // Số mẻ sản xuất thực tế
  maDinhMuc                     String  @default("") // Mã định mức
  tongKhoiLuongNguyenLieu       Float   @default(0) // Tổng khối lượng nguyên liệu đã sử dụng (kg)
  tongKhoiLuongThanhPhamDinhMuc Float   @default(0) // Tổng khối lượng thành phẩm định mức (kg)
  khoiLuongThanhPhamThucTe      Float   @default(0) // Khối lượng thành phẩm thu được thực tế (kg)
  chenhLechKhoiLuong            Float   @default(0) // Chênh lệch khối lượng (kg)
  danhGiaChenhLech              String  @default("") // Đánh giá chênh lệch
  nguyenNhanChenhLech           String  @default("") // Nguyên nhân chênh lệch
  deXuatDieuChinh               String  @default("") // Đề xuất điều chỉnh, cải tiến
  fileDinhKem                   String? // File đính kèm
  nguoiThucHien                 String  @default("") // Người thực hiện

  createdById String? // soft ref to auth.User.id — no FK constraint
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
  @@map("production_reports")
  @@schema("business")
}
