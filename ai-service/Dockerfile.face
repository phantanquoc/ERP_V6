# AI Service - Face Recognition Only (dev)
FROM python:3.11-slim

WORKDIR /app

# System deps for opencv / image processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    gosu \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip

COPY requirements.face.txt .
RUN pip install --no-cache-dir -r requirements.face.txt

COPY config.py .
COPY app.py .
COPY main.py .
COPY face/ ./face/

EXPOSE 8001

RUN useradd -r -m -s /bin/false appuser && chown -R appuser:appuser /app

COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
