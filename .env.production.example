# ============================================
# ERP System - Production Environment (300 Users)
# ============================================
# ⚠️  QUAN TRỌNG: Thay đổi TẤT CẢ giá trị mặc định trước khi deploy!
# Tạo JWT secret: openssl rand -base64 64
# Tạo mật khẩu: openssl rand -base64 32
# ============================================

# === DATABASE ===
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=THAY_DOI_MAT_KHAU_MANH_TAI_DAY
POSTGRES_DB=erp_database

# === JWT ===
JWT_SECRET=THAY_BANG_CHUOI_NGAU_NHIEN_64_KY_TU
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=THAY_BANG_CHUOI_NGAU_NHIEN_KHAC_64_KY_TU
JWT_REFRESH_EXPIRE=30d

# === DOMAIN ===
CORS_ORIGIN=https://anbinhfoods.net,https://www.anbinhfoods.net
API_URL=https://anbinhfoods.net/api
VITE_API_URL=https://anbinhfoods.net/api

# === LOGGING (Production) ===
LOG_LEVEL=warn

# ============================================
# YÊU CẦU SERVER TỐI THIỂU CHO 300 USERS:
# - CPU: 4 cores trở lên
# - RAM: 8GB trở lên (khuyến nghị 16GB)
# - Disk: SSD, tối thiểu 100GB
# - Network: 100Mbps trở lên
# ============================================